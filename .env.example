# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- Stigi agent (OpenRouter) ---------------------------------------------
# The key goes ONLY in your git-ignored .env and in Vercel's production env.
# OPENROUTER_API_KEY=
# Active LLM path (2026-11-09): Google Gemini via AI Studio. The key goes ONLY in .env and in
# Vercel production env (as a Sensitive variable).
# GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_ENGINE=ai-sdk:google
AGENT_MODEL=gemini-3.5-flash-lite
# gemini-3.8-flash returned 503 (high demand) and gemini-2.5-flash 404 (retired for new users) on 2026-11-09.
# Dormant previous path: AGENT_ENGINE=ai-sdk:openrouter, AGENT_MODEL=anthropic/claude-sonnet-5.5 (OPENROUTER_API_KEY).
AGENT_ENGINE_PREFER_BYO_KEY=1
# Per-user daily cap on agent turns (public demo protection)
STIGI_DAILY_AGENT_TURNS=40
# Production only, set temporarily by the deploy skeleton's probe step, then removed:
# STIGI_ENABLE_PROBE=1
